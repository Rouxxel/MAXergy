# MAXergy MCP service environment variables.
# Legacy MAXNERGY_* names are still read as a fallback (deprecated; will be removed).

# MAXergy backend (maxergy-api): all savings numbers come from its POST /plan, engine defaults
# from GET /assumptions.
MAXERGY_API_BASE_URL=http://localhost:8000
# Bearer token sent to the backend (service-to-service auth). Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MAXERGY_SERVICE_TOKEN=

# Bearer tokens accepted from internal services (comma-separated), in addition to the public
# auth mode below. Put the backend's MAXERGY_MCP_TOKEN here so it can call the enrichment tools.
MAXERGY_INTERNAL_TOKENS=

# Google Cloud key with the Solar API + Geocoding API enabled (billing must be on).
# Used for roof geometry (tilt / azimuth / area) and address -> lat/lon.
GOOGLE_MAPS_API_KEY=

# --- Auth: pick a mode (switchable on redeploy, no code change) ---
#   bearer     : shared-secret token (MAXERGY_API_TOKEN). Claude Code / Anthropic API.
#   fastmcp    : FastMCP is its own OAuth server (DCR + authorize + token), NO external
#                IdP. Lets the claude.ai web/desktop/mobile connector attach with zero
#                setup. Caveat: simulated consent (no real login) + in-memory state, so
#                it's effectively open access and re-auths after a redeploy.
#   passphrase : like fastmcp, but the authorization step is gated by one shared
#                passphrase (MAXERGY_AUTH_PASSPHRASE). Works in the claude.ai app.
#   google     : real Google login via OAuth proxy (genuine per-user access control);
#                needs GOOGLE_OAUTH_CLIENT_ID/SECRET and a Google Web OAuth client whose
#                redirect URI is  https://<your-domain>/auth/callback
MAXERGY_AUTH_MODE=bearer

# Used when MAXERGY_AUTH_MODE=passphrase.
MAXERGY_AUTH_PASSPHRASE=

# Public https URL of the server (used by the OAuth modes for metadata/redirects).
# Auto-derived from RAILWAY_PUBLIC_DOMAIN on Railway if left unset.
PUBLIC_BASE_URL=

# Persist OAuth state (registered clients + tokens) to this file so the claude.ai
# connector's client_id survives redeploys/restarts. Point at a Railway volume mount,
# e.g. /data/oauth.json. Unset = in-memory (clients must re-auth after each deploy).
# Used by the 'passphrase' self-hosted OAuth mode.
MAXERGY_OAUTH_STATE_PATH=

# Used when MAXERGY_AUTH_MODE=bearer. Empty = unauthenticated (local stdio).
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MAXERGY_API_TOKEN=

# Logging verbosity: INFO (default, normal flow) or DEBUG (adds internals).
# Logs go to stdout; Railway captures them in the deploy logs tab.
LOG_LEVEL=INFO

# Used when MAXERGY_AUTH_MODE=google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: stable JWT signing key so google-mode access tokens survive redeploys.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MAXERGY_JWT_SIGNING_KEY=

# Transport override (stdio|http). Auto: http when PORT is set (Railway), else stdio.
# MCP_TRANSPORT=http

# Tariff, feed-in and other defaults come from the backend engine via GET /assumptions
# (the former MAXNERGY_ELECTRICITY_PRICE_EUR_PER_KWH / MAXNERGY_FEED_IN_EUR_PER_KWH were never read).
