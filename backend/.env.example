# MAXergy Backend Environment Variables
# Copy this file to .env.local for local development

# Environment
ENVIRONMENT=development

# Server Configuration default
SERVER_PORT=8000
HOST=0.0.0.0
RELOAD=false
WORKERS=1

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Trusted Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Security Keys (replace with actual keys in production)
E_PRIVATE_KEY=your_private_key_here
E_PRIVATE_PASSWORD=your_private_password_here
E_PUBLIC_KEY=your_public_key_here

# Database Configuration (uncomment if using database)
# POSTGRES_DB=api_db
# POSTGRES_USER=api_user
# POSTGRES_PASSWORD=api_password
# DATABASE_URL=postgresql://api_user:api_password@postgres:5432/api_db

# Redis Configuration (uncomment if using Redis)
# REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=info

# API Configuration
API_TITLE=MAXergy API
API_VERSION=1.0.0
API_DESCRIPTION=Energy forecasting and recommendation API

# Third parties
# AI advisor (google-genai). Without a key: 503 in production, canned replies only with ENVIRONMENT=development.
GEMINI_API_KEY=key_here
# GEMINI_MODEL=gemini-3.5-flash
MAPS_API_KEY=key_here

# Railway / reverse proxy: PORT overrides SERVER_PORT; trust X-Forwarded-For from the proxy
# so rate limits apply per client IP (set FORWARDED_ALLOW_IPS=* on Railway)
# PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1

# Service-to-service auth: bearer token the MCP service sends (its MAXERGY_SERVICE_TOKEN).
# Valid token -> separate "service" rate limit; wrong token -> 401. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MAXERGY_SERVICE_TOKEN=

# MCP enrichment (POST /location/enrich): geocoding, roof geometry, PVGIS via maxergy-mcp
MCP_ENABLED=false
MCP_BASE_URL=http://localhost:8080
# Bearer token accepted by the MCP (listed in its MAXERGY_INTERNAL_TOKENS)
MAXERGY_MCP_TOKEN=