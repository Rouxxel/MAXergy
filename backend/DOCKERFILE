#############################################################################
### Multi-stage Dockerfile for MAXergy
### FastAPI + Uvicorn + Python 3.12
### Optimized for production deployment
###
### Build context = REPOSITORY ROOT (the API imports the production engine in
### scripts/energy_model, which reads data/):
###   docker build -f backend/DOCKERFILE -t maxergy-api .
### Ignore rules: backend/DOCKERFILE.dockerignore
#############################################################################

# Build stage
FROM python:3.12-slim AS builder

WORKDIR /app

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Production stage
FROM python:3.12-slim

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app/backend

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder stage
COPY --from=builder /root/.local /home/appuser/.local

# Copy application code: backend, production engine, engine data, benchmark household (GET /benchmark)
COPY backend/ /app/backend/
COPY scripts/ /app/scripts/
COPY data/ /app/data/
COPY documentation/data/test_profiles/ /app/documentation/data/test_profiles/

# Create logs directory
RUN mkdir -p logs && chown -R appuser:appuser logs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV PATH=/home/appuser/.local/bin:$PATH

# Change ownership of app directory
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Health check (PORT is injected by Railway; 8000 locally)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/ || exit 1

# Expose port (configurable via environment)
EXPOSE 8000

# Run the application
CMD ["python", "main.py"]
