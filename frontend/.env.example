# MAXergy frontend environment

# Base URL of the FastAPI backend (no trailing slash)
# VITE_DEPLOYED_API_BASE_URL is checked first (for production deployments)
# VITE_API_BASE_URL is used as fallback (for local development)
VITE_API_BASE_URL=http://localhost:8000
# Set only for deployed builds (it overrides VITE_API_BASE_URL when present):
# VITE_DEPLOYED_API_BASE_URL=https://<maxergy-api-domain>

# When "true", endpoints return local fixtures instead of calling the backend.
# Set to "false" once your backend is running to use the real /assessment, /plan,
# /location/enrich and /advisor/chat endpoints. Mock mode returns a recorded /plan response
# for the example household (src/services/fixtures/plan_model_input1.json).
VITE_USE_MOCKS=false