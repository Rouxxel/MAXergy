EXPO_LOCAL_API_BASE_URL=http://localhost:8000
# Backend URL; on a physical device use your machine's LAN IP or the deployed maxergy-api domain
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# "false" to call the backend (POST /assessment, /plan, /advisor/chat); otherwise mocks replay a
# recorded /plan response for the example household
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_ENABLE_ANALYTICS=true
